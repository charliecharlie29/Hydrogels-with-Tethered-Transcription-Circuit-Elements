TH19.seq = thT19* thR19* ta* thG19* thH19* thG19
TH20.seq = thT20* thR20* ta* thG20* thH20* thG20

# repressor
rR1.seq = thG1* thH1 thG1 ta thR1 thT1
rR2.seq = thG2* thH2 thG2 ta thR2 thT2
rR3.seq = thH3 thG3 ta thR3 thT3
rR4.seq = thH4 thG4 ta thR4 thT4
rR5.seq = thH5 thG5 ta thR5 thT5
rR6.seq = thH6 thG6 ta thR6 thT6
rR7.seq = thH7 thG7 ta thR7 thT7
rR8.seq = thH8 thG8 ta thR8 thT8
rR9.seq = thH9 thG9 ta thR9 thT9
rR10.seq = thH10 thG10 ta thR10 thT10
rR11.seq = thH11 thG11 ta thR11 thT11
