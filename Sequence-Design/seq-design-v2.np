# tubes
tube Rs = rR1 rR2 rR3 rR4 rR5 rR6 rR7 rR8 rR9 rR10 rR11 rR12 rR13 rR14 rR15 rR16 rR17 rR18 rR19 rR20
tube THs = TH1 TH2 TH3 TH4 TH5 TH6 TH7 TH8 TH9 TH10 TH11 TH12 TH13 TH14 TH15 TH16 TH17 TH18 TH19 TH20
Rs.maxsize = 2
THs.maxsize = 2

# constraints
prevent = AAAA, CCCC, GGGG, UUUU, KKKKKK, MMMMMM, RRRRRR, SSSSSS, WWWWWW, YYYYYY
