# thread sequence domains onto target structures
# transcription switch
G1.seq = thR1* ta* thG1* thH1* thG1 ta
G2.seq = thR2* ta* thG2* thH2* thG2 ta
G3.seq = thR3* ta* thG3* thH3* thG3 ta
G4.seq = thR4* ta* thG4* thH4* thG4 ta
