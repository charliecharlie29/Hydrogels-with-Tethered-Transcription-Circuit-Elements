domain thR15 = H5
domain thR16 = H5
domain thR17 = H5
domain thR18 = H5
domain thR19 = H5
domain thR20 = H5

# transcription switch branch-migration domain
domain thG1 = GCGTCGGT
domain thG2 = GCGTCATC
domain thG3 = H8
